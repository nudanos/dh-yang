#!/usr/bin/perl -w

=head1 NAME

dh_yang - Track YANG import dependencies

=cut

use strict;
use warnings;
use Debian::Debhelper::Dh_Lib;
use File::Find;

init();

foreach my $package ( @{ $dh{DOPACKAGES} } ) {
    my $tmp = tmpdir($package);
    my @yang_files;
    find( { wanted => sub { push @yang_files, $_ if -f && /[.]yang\z/x }, no_chdir => 1 }, $tmp )
      if -d $tmp;

    ## TODO - Use proper yang parser for dependencies
    ## Check Yang compiles!?
    my @yang_deps;
    foreach my $file (@yang_files) {
        open my $fh, "<", $file or error("$file: $!");
        while ( my $line = <$fh> ) {
            if ( $line =~ /^\s+import\s(\S+)\s+{/x ) {
                push @yang_deps, "$1-yang";
            }
        }
        close $fh or error("$file: $!");
    }

    addsubstvar( $package, "yang:Depends", join( ", ", @yang_deps ) );
}
